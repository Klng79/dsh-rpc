#!/usr/bin/env node
'use strict';

/*
 * dsh-rpc — drive the DeepSeek Harness (dsh) web-server /api RPC endpoint from the CLI.
 *
 * dsh's web UI is a React client over a local HTTP RPC bridge (`/api`) plus two
 * WebSocket downlinks. This tool talks to the same `/api` bridge directly, so
 * sessions it creates are GROUPED under a workspace exactly like ones created in
 * the web UI (unlike `dsh --profile headless`, which is always ungrouped).
 *
 * Transport (reverse-engineered from @deepseek-ai/dsh v0.1.0-rc.6):
 *   POST <BASE>/api/<method>
 *   Content-Type: application/json
 *   body: { "type":"client-request", "rpcId":<uuid>, "method":<method>, "payload":{...} }
 *   resp: { "type":"server-response", "rpcId":<uuid>,
 *           "result": { "ok":true, "value":... } | { "ok":false, "error":{code,message} } }
 *
 * The server enforces a browser-trust fence: the request Host must be a loopback
 * authority (127.0.0.1 / localhost) or a declared --trusted-host. Running locally,
 * plain fetch to 127.0.0.1 passes automatically. No auth layer exists (loopback only).
 *
 * Safety features: permission is set via the `commands/execute` RPC + verified
 * against the `permissions` projection; completion requires a `turn/end` with
 * reason "completed"; pending approvals and timeouts cancel the session instead
 * of leaving it running.
 *
 * Environment:
 *   DSH_URL       server base url        (default http://127.0.0.1:3080)
 *   DSH_POLL_MS   completion poll period (default 1000)
 *
 * This file is intentionally dependency-free and module-system agnostic
 * (no require/import, no top-level await) so it runs under either CJS or ESM.
 */

const BASE = (process.env.DSH_URL || 'http://127.0.0.1:3080').replace(/\/+$/, '');
const POLL_MS = Number(process.env.DSH_POLL_MS || 1000);
// Per-request timeout for the /api bridge. dsh's server does its long-running
// work asynchronously, so a single request should never take more than this;
// it exists to keep a hung server from trapping the CLI forever. Override with
// DSH_RPC_TIMEOUT_MS.
const RPC_TIMEOUT_MS = Number(process.env.DSH_RPC_TIMEOUT_MS || 30000);

// Project identity for `version` / `--version` / `-V`.
const NAME = 'dsh-rpc';
const VERSION = '0.2.0';
const REPO = 'https://github.com/Klng79/dsh-rpc';

function uuid() {
  const c = globalThis.crypto;
  if (c && typeof c.randomUUID === 'function') return c.randomUUID();
  return 'rpc-' + Date.now().toString(36) + '-' + Math.random().toString(36).slice(2, 10);
}

const sleep = (ms) => new Promise((r) => setTimeout(r, ms));

// While a session is being waited on, SIGINT (Ctrl-C) cancels it instead of
// leaving it running unattended — matching the tool's cancel-on-approval /
// cancel-on-timeout safety behavior. cancelSession is declared below; the
// handler only runs after module load, so hoisting covers it.
let activeSession = null;
let cancelInFlight = false;

process.on('SIGINT', () => {
  const id = activeSession;
  activeSession = null;
  process.stderr.write('\ninterrupted — cancelling session' + (id ? ' ' + id : '') + '\n');
  process.exitCode = 130;
  // No active session: nothing to cancel, exit now. A second Ctrl-C while a
  // cancel is already in flight force-exits — the user clearly wants out now.
  if (!id || cancelInFlight) { process.exit(130); return; }
  cancelInFlight = true;
  // process.exit() drops pending async I/O, so the fire-and-forget cancel
  // would almost never be sent. Await the cancel (bounded, so a hung server
  // can't trap the user forever) before exiting with the documented 130 code.
  Promise.race([cancelSession(id), sleep(2000)])
    .catch(() => {})
    .finally(() => process.exit(130));
});

async function rpc(method, payload) {
  const rpcId = uuid();
  const controller = new AbortController();
  const timer = setTimeout(() => controller.abort(), RPC_TIMEOUT_MS);
  try {
    let res;
    try {
      res = await fetch(`${BASE}/api/${method}`, {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ type: 'client-request', rpcId, method, payload: payload || {} }),
        signal: controller.signal,
      });
    } catch (e) {
      if (controller.signal.aborted) {
        throw new Error(`request to ${method} timed out after ${RPC_TIMEOUT_MS}ms`);
      }
      throw new Error(`cannot reach dsh at ${BASE} — is the web UI running? (${e.message})`);
    }
    if (!res.ok) {
      const text = (await res.text().catch(() => '')).slice(0, 200);
      throw new Error(`transport failure ${res.status} for ${method}${text ? ': ' + text : ''}`);
    }
    const full = await res.json();
    // Verify the envelope before trusting `result`: it must be a server-response
    // that echoes our rpcId, and it must carry a result. Never trust `result`
    // from a mismatched or malformed reply.
    if (!full || full.type !== 'server-response' || full.rpcId !== rpcId || !full.result) {
      throw new Error(`malformed or mismatched response for ${method}`);
    }
    if (!full.result.ok) {
      const err = full.result.error || {};
      throw new Error(`${method} failed: ${err.code || 'unknown'}${err.message ? ': ' + err.message : ''}`);
    }
    return full.result.value;
  } finally {
    clearTimeout(timer);
  }
}

/* ---- helpers ---- */

function resolvePath(p) {
  if (!p) return process.cwd();
  if (p === '~') return process.env.HOME;
  if (p.indexOf('~/') === 0) return process.env.HOME + p.slice(1);
  if (p.indexOf('/') === 0) return p;
  return process.cwd() + '/' + p;
}

// Return the value that follows a --flag at args[flagIndex], or throw a clear
// error if the flag is the last argument or the next token looks like a flag.
function nextValue(args, flagIndex, flag) {
  const v = args[flagIndex + 1];
  if (v === undefined || (v.length > 0 && v[0] === '-' && v !== '-')) {
    throw new Error(`${flag} requires a value`);
  }
  return v;
}

function parseTimeoutSeconds(v, flag) {
  const n = Number(v);
  if (!Number.isFinite(n) || n <= 0) {
    throw new Error(`${flag} must be a positive number of seconds`);
  }
  return n * 1000;
}

function textOf(message) {
  const parts = [];
  for (const block of (message && message.content) || []) {
    if (block && block.type === 'text' && typeof block.text === 'string') parts.push(block.text);
  }
  return parts.join('\n');
}

async function listWorkspaces() {
  return (await rpc('workspace.list', {})).items || [];
}

async function findWorkspaceByPath(absPath) {
  const items = await listWorkspaces();
  return items.find((w) => w.path === absPath);
}

// Return the existing workspace for absPath, or (when allowCreate) create it.
// A missing workspace FAILS unless allowCreate is set — auto-create stays OFF
// by default so a typo'd path doesn't silently mint a new empty workspace.
async function ensureWorkspace(absPath, allowCreate) {
  const existing = await findWorkspaceByPath(absPath);
  if (existing) return existing;
  if (!allowCreate) {
    throw new Error(`workspace not found at ${absPath} — pass --create-workspace to create it`);
  }
  const created = await rpc('workspace.create', { path: absPath });
  return created.workspace;
}

// Return true if `entry` at array `index` is strictly after the checkpoint.
// A checkpoint is `{ maxSeq?, count }` captured from a history snapshot taken
// BEFORE this submission's prompt, so anything at-or-before it is stale (from
// an earlier turn) and must not be reused as this submission's result.
function isAfterCheckpoint(entry, index, checkpoint) {
  if (!checkpoint) return true;
  const ev = entry && entry.event ? entry.event : entry;
  const seq = typeof entry.seq === 'number' ? entry.seq
    : typeof ev.seq === 'number' ? ev.seq : undefined;
  // Prefer a seq boundary when the history carries seq numbers...
  if (typeof checkpoint.maxSeq === 'number' && typeof seq === 'number') {
    return seq > checkpoint.maxSeq;
  }
  // ...otherwise fall back to the event-count boundary.
  return index >= checkpoint.count;
}

// Snapshot the boundary between already-applied history and events produced by
// the prompt we are about to submit. Returns `{ maxSeq?, count }`.
function computeCheckpoint(history) {
  const events = (history && history.events) || [];
  let maxSeq;
  for (const entry of events) {
    const ev = entry && entry.event ? entry.event : entry;
    const seq = typeof entry.seq === 'number' ? entry.seq
      : typeof ev.seq === 'number' ? ev.seq : undefined;
    if (typeof seq === 'number' && (maxSeq === undefined || seq > maxSeq)) maxSeq = seq;
  }
  return { maxSeq, count: events.length };
}

function getHistory(sessionId) {
  return rpc('session.history', { sessionId, maxMessages: 200 });
}

function finalAssistantText(history, checkpoint) {
  const events = (history && history.events) || [];
  // walk newest-to-oldest; return the last assistant message that has visible
  // text and is strictly after the checkpoint (i.e. from this submission)
  for (let i = events.length - 1; i >= 0; i--) {
    const ev = events[i].event || events[i];
    if (!isAfterCheckpoint(events[i], i, checkpoint)) continue;
    if (ev.type === 'assistant/message' && ev.data && ev.data.message) {
      const text = textOf(ev.data.message);
      if (text.trim() !== '') return text;
    }
  }
  return '';
}

/* ---- safety helpers ---- */

function currentPermission(history) {
  const proj = history && history.projections && history.projections.values && history.projections.values.permissions;
  if (proj && typeof proj.currentValue === 'string') return proj.currentValue;
  const events = (history && history.events) || [];
  for (let i = events.length - 1; i >= 0; i--) {
    const ev = events[i].event || events[i];
    if (ev.type === 'permission/preset' && ev.data && typeof ev.data.preset === 'string') return ev.data.preset;
  }
  return undefined;
}

function latestTurnEnd(history, checkpoint) {
  const events = (history && history.events) || [];
  for (let i = events.length - 1; i >= 0; i--) {
    const ev = events[i].event || events[i];
    if (ev.type === 'turn/end' && isAfterCheckpoint(events[i], i, checkpoint)) return ev;
  }
  return undefined;
}

function pendingApproval(history) {
  const pending = new Map();
  for (const entry of (history && history.events) || []) {
    const ev = entry.event || entry;
    if (ev.type === 'approval/asked' && ev.data && ev.data.id) pending.set(ev.data.id, ev.data);
    else if (ev.type === 'approval/decided' && ev.data && ev.data.id) pending.delete(ev.data.id);
  }
  const first = pending.values().next();
  return first.done ? undefined : first.value;
}

function cancelSession(sessionId) {
  return rpc('session.cancel', { sessionId });
}

// Find the LAST terminal job marker of the form DEEPSEEK_<KIND>:<id> in text.
// Returns { kind, jobId } or undefined. When jobId is given, only a marker
// whose id matches it counts.
function findJobMarker(text, jobId) {
  if (!text) return undefined;
  const re = /DEEPSEEK_(DONE|BLOCKED|NEEDS_INPUT):([0-9A-Za-z_-]+)/g;
  let m;
  let last;
  while ((m = re.exec(text))) last = m;
  if (!last) return undefined;
  if (jobId && last[2] !== jobId) return undefined;
  return { kind: last[1], jobId: last[2] };
}

// Like findJobMarker but for any job id — used by `status` to report an outcome.
function findAnyJobMarker(text) {
  return findJobMarker(text);
}

// Read a UTF-8 text file. Uses dynamic import so the script stays runnable
// under both CJS and ESM (no top-level require/import).
async function readTextFile(p) {
  const fs = await import('node:fs');
  return fs.readFileSync(resolvePath(p), 'utf8');
}

// Extract the preset names a deployment actually offers, from the session's
// `permissions` projection (projections.values.permissions.options). Tolerates
// options being an array of strings or of objects ({name|value|id|key}).
function permissionPresetNames(history) {
  const proj = history && history.projections && history.projections.values && history.projections.values.permissions;
  const options = proj && proj.options;
  if (!Array.isArray(options)) return [];
  const names = [];
  for (const o of options) {
    if (typeof o === 'string') { if (o) names.push(o); }
    else if (o && typeof o === 'object') {
      const n = o.name || o.value || o.id || o.key;
      if (typeof n === 'string' && n) names.push(n);
    }
  }
  return names;
}

async function applyAndVerifyPermission(sessionId, permission) {
  // Deployment-level check: only accept presets this deployment actually offers.
  // If the projection exposes no options we skip the pre-check and rely on the
  // verify step below (a wrong preset still fails verification).
  const history = await getHistory(sessionId);
  const names = permissionPresetNames(history);
  if (names.length && !names.includes(permission)) {
    throw new Error(`permission "${permission}" is not offered by this deployment; available: ${names.join(', ')}`);
  }
  // `commands/execute` on dsh >= 0.1.1-rc.2 requires an `images` arg (array of
  // { mediaType, data, name? }); send an empty array since we never attach media.
  const exec = await rpc('commands/execute', {
    args: { agentId: sessionId, line: `/permission ${permission}`, images: [] },
  });
  if (!exec || !exec.result || exec.result.kind !== 'success') {
    const detail = exec && exec.result && exec.result.text ? `: ${exec.result.text}` : '';
    throw new Error(`could not set permission "${permission}" for ${sessionId}${detail}`);
  }
  const verified = await getHistory(sessionId);
  const actual = currentPermission(verified);
  if (actual && actual !== permission) {
    throw new Error(`permission verification failed for ${sessionId}: expected ${permission}, got ${actual}`);
  }
}

// Build a `{ provider?, model, reasoningEffort? }` selection from the CLI flags.
// `--model` accepts either a bare model id (disambiguated against the catalog)
// or a `provider/model` pair; `--provider`/`--reasoning-effort` are optional
// disambiguators/overrides. Returns null when nothing model-related was given.
function buildModelSelection(model, provider, reasoningEffort) {
  if (model === null && provider === null && reasoningEffort === null) return null;
  if (model === null) throw new Error('--provider requires --model');
  let m = model;
  let p = provider;
  if (p === null && model.includes('/')) {
    const idx = model.lastIndexOf('/');
    p = model.slice(0, idx) || null;
    m = model.slice(idx + 1);
    if (!p) throw new Error(`invalid --model "${model}": missing provider before "/"`);
  }
  if (!m) throw new Error('--model requires a model id');
  return { model: m, provider: p || undefined, reasoningEffort: reasoningEffort || undefined };
}

// One `provider/model` string per catalog entry, for error/discovery messages.
function describeModels(cat) {
  const groups = cat && cat.groups ? cat.groups : [];
  const parts = [];
  for (const g of groups) {
    for (const m of (g.models || [])) parts.push(`${g.id}/${m.id}`);
  }
  return parts.join(', ') || '(none loaded)';
}

// Apply a model selection to a session: fetch the catalog (`session.models`),
// resolve a bare model id against it (or fill a default reasoning effort), then
// commit via `session.selectModel`. selectModel is authoritative, but resolving
// here gives clear errors and avoids guessing at provider/model ids.
async function applyModelSelection(sessionId, model) {
  const cat = await rpc('session.models', { sessionId });
  let provider = model.provider;
  if (!provider) {
    const matches = [];
    for (const g of (cat.groups || [])) {
      for (const m of (g.models || [])) if (m.id === model.model) matches.push(g.id);
    }
    if (matches.length === 1) provider = matches[0];
    else if (matches.length === 0) {
      throw new Error(`model "${model.model}" not found for ${sessionId}; available: ${describeModels(cat)}`);
    } else {
      throw new Error(`model "${model.model}" is offered by multiple providers (${matches.join(', ')}); pass --provider to disambiguate`);
    }
  }
  const group = (cat.groups || []).find((g) => g.id === provider);
  const entry = group && (group.models || []).find((mm) => mm.id === model.model);
  if (!entry) throw new Error(`model "${provider}/${model.model}" not found for ${sessionId}; available: ${describeModels(cat)}`);
  let reasoningEffort = model.reasoningEffort;
  if (!reasoningEffort && entry.reasoning && entry.reasoning.defaultEffort) reasoningEffort = entry.reasoning.defaultEffort;
  const payload = { sessionId, provider, model: model.model };
  if (reasoningEffort) payload.reasoningEffort = reasoningEffort;
  await rpc('session.selectModel', payload);
}

async function waitForCompletion(sessionId, timeoutMs, quiet, checkpoint, requestedPermission, pollMs) {
  const deadline = Date.now() + timeoutMs;
  const start = Date.now();
  const period = (pollMs && pollMs > 0) ? pollMs : POLL_MS;
  let sawRunning = false;
  while (Date.now() < deadline) {
    let summary;
    let history;
    try {
      const list = await rpc('session.list', {});
      summary = (list.items || []).find((i) => i.sessionId === sessionId);
      history = await getHistory(sessionId);
    } catch (e) {
      /* transient server hiccup — keep polling */
    }
    if (history) {
      const approval = pendingApproval(history);
      if (approval) {
        await cancelSession(sessionId).catch(() => {});
        throw new Error(`session requested approval for ${approval.toolName || 'an operation'}; cancelled`);
      }
      // Permission-drift detection: only when a permission was explicitly
      // requested. If the session's current permission no longer matches the
      // one we requested, cancel and fail — an unattended run must not continue
      // under a permission the operator didn't ask for. When no permission is
      // requested this check is skipped entirely (no read-only default, no fail).
      if (requestedPermission) {
        const current = currentPermission(history);
        if (current && current !== requestedPermission) {
          await cancelSession(sessionId).catch(() => {});
          throw new Error(
            `permission drifted during run for ${sessionId}: expected ${requestedPermission}, got ${current}; cancelled`
          );
        }
      }
    }
    if (summary && summary.running) sawRunning = true;
    const graceDone = sawRunning || (Date.now() - start > 3000);
    if (summary && summary.running === false && graceDone) {
      // stronger completion gate: surface a non-"completed" terminal reason
      const turnEnd = history ? latestTurnEnd(history, checkpoint) : undefined;
      const kind = turnEnd && turnEnd.data && turnEnd.data.reason ? turnEnd.data.reason.kind : undefined;
      if (kind && kind !== 'completed') {
        // Surface the underlying terminal error (e.g. a provider auth failure)
        // instead of stopping at an opaque "reason error".
        const err = turnEnd && turnEnd.data && turnEnd.data.reason && turnEnd.data.reason.error;
        const detail = err && err.message ? `: ${err.message}` : '';
        throw new Error(`session ended with reason "${kind}" (not completed)${detail}`);
      }
      return;
    }
    if (!quiet) {
      const secs = Math.round((Date.now() - start) / 1000);
      process.stderr.write(`\r  dsh working… ${secs}s${summary && summary.running ? ' (running)' : ''}   `);
    }
    await sleep(period);
  }
  await cancelSession(sessionId).catch(() => {});
  throw new Error(`timed out after ${timeoutMs}ms; cancelled session ${sessionId}`);
}

// Shared core for `run`, `prompt --wait` and `fork --no-wait`/text: apply the
// model selection (if requested), set+verify the permission (if requested),
// enqueue the prompt, then either print the session id immediately (`onIdle`)
// or wait for completion and print the final assistant text. Whether to cancel
// the session on error is left to the caller: `run`/`fork` cancel their
// freshly-created session, `prompt` does not (that session may pre-exist).
async function runSession({ sessionId, task, wait, quiet, permission, timeoutMs, model, onIdle, jobId, json, pollMs }) {
  activeSession = sessionId;
  try {
    if (permission) {
      await applyAndVerifyPermission(sessionId, permission);
      if (!quiet) console.error(`verified permission ${permission}`);
    }
    if (model) {
      await applyModelSelection(sessionId, model);
      if (!quiet) console.error(`selected model ${model.provider}/${model.model}`);
    }
    // Capture the history right BEFORE the prompt and checkpoint it, so a stale
    // turn/end or answer from an earlier prompt can never be reused as the
    // result of this submission.
    const checkpoint = computeCheckpoint(await getHistory(sessionId));
    await rpc('session.prompt', {
      sessionId,
      mode: 'queue',
      content: [{ type: 'text', text: task }],
    });
    if (!wait) {
      onIdle({ sessionId }, json);
      return { sessionId };
    }
    await waitForCompletion(sessionId, timeoutMs, quiet, checkpoint, permission, pollMs);
    if (!quiet) process.stderr.write('\n');
    const history = await getHistory(sessionId);
    const assistantText = finalAssistantText(history, checkpoint);
    const turnEnd = latestTurnEnd(history, checkpoint);
    const approval = pendingApproval(history);
    const evidence = {
      sessionId,
      running: false,
      permission: currentPermission(history) || null,
      pendingApproval: approval ? (approval.id || null) : null,
      turnEndReason: turnEnd && turnEnd.data && turnEnd.data.reason ? turnEnd.data.reason.kind : null,
      outcome: null,
      assistantText,
    };
    if (jobId) {
      const marker = findJobMarker(assistantText, jobId);
      if (!marker) {
        throw new Error(`job ${jobId}: response did not end with a terminal marker (DEEPSEEK_DONE/BLOCKED/NEEDS_INPUT:${jobId})`);
      }
      evidence.outcome = marker.kind;
      if (marker.kind === 'BLOCKED') process.exitCode = 3;
      else if (marker.kind === 'NEEDS_INPUT') process.exitCode = 4;
    } else {
      const marker = findAnyJobMarker(assistantText);
      if (marker) evidence.outcome = marker.kind;
    }
    if (json) {
      console.log(JSON.stringify(evidence, null, 2));
    } else {
      console.log(assistantText || '(no assistant text captured — use `dsh-rpc history ' + sessionId + '`)');
    }
    if (!quiet) console.error(`\n[done] session ${sessionId}`);
    return evidence;
  } finally {
    activeSession = null;
  }
}

/* ---- flag parsing ---- */

// Parse argv against a flag spec: { '<flag>': { key, type:'value'|'bool' } }.
// Unknown flags are rejected BEFORE any RPC call. `--` makes every following
// token literal (task text), so a task starting with a dash is expressible.
function parseArgs(args, spec, usage) {
  const opts = {};
  const positional = [];
  let literal = false;
  for (let i = 0; i < args.length; i++) {
    const a = args[i];
    if (literal) { positional.push(a); continue; }
    if (a === '--') { literal = true; continue; }
    if (typeof a === 'string' && a.length > 0 && a[0] === '-') {
      const def = spec[a];
      if (!def) throw new Error(`unknown flag: ${a}${usage ? '\n' + usage : ''}`);
      if (def.type === 'value') {
        const v = nextValue(args, i, a);
        i++;
        opts[def.key] = v;
      } else {
        opts[def.key] = true;
      }
    } else {
      positional.push(a);
    }
  }
  return { opts, positional };
}

// Common flags shared by run/prompt/fork.
const BASE_SPEC = {
  '--permission': { key: 'permission', type: 'value' },
  '-p': { key: 'permission', type: 'value' },
  '--allow-danger-full-access': { key: 'allowDanger', type: 'bool' },
  '--quiet': { key: 'quiet', type: 'bool' },
  '-q': { key: 'quiet', type: 'bool' },
  '--timeout': { key: 'timeout', type: 'value' },
  '--model': { key: 'model', type: 'value' },
  '--provider': { key: 'provider', type: 'value' },
  '--reasoning-effort': { key: 'reasoningEffort', type: 'value' },
  '--task-file': { key: 'taskFile', type: 'value' },
  '--job-id': { key: 'jobId', type: 'value' },
  '--json': { key: 'json', type: 'bool' },
  '--poll-ms': { key: 'pollMs', type: 'value' },
  '--create-workspace': { key: 'createWorkspace', type: 'bool' },
  '--require-title': { key: 'requireTitle', type: 'value' },
};

const RUN_SPEC = Object.assign({}, BASE_SPEC, {
  '--workspace': { key: 'workspace', type: 'value' },
  '-w': { key: 'workspace', type: 'value' },
  '--no-wait': { key: 'noWait', type: 'bool' },
});
const PROMPT_SPEC = Object.assign({}, BASE_SPEC, {
  '--wait': { key: 'wait', type: 'bool' },
});
const FORK_SPEC = Object.assign({}, BASE_SPEC, {
  '--at-seq': { key: 'atSeq', type: 'value' },
  '--no-wait': { key: 'noWait', type: 'bool' },
});

function parsePollMs(v) {
  const n = Number(v);
  if (!Number.isFinite(n) || n <= 0) throw new Error('--poll-ms must be a positive number of milliseconds');
  return n;
}

// Combine --task-file with (optionally-empty) positional task text. Errors if
// both are given. Returns the task string.
async function taskFromOptions(opts, positionalText) {
  if (opts.taskFile) {
    if (positionalText.trim() !== '') {
      throw new Error('--task-file cannot be combined with positional task text');
    }
    return (await readTextFile(opts.taskFile)).trim();
  }
  return positionalText;
}

/* ---- commands ---- */

async function cmdWorkspaces() {
  const items = await listWorkspaces();
  if (!items.length) { console.log('(no workspaces)'); return; }
  for (const w of items) {
    console.log(`${w.workspaceId}  ${w.title}  [${w.sessionIds.length} sessions]  ${w.path}`);
  }
}

async function cmdSessions() {
  const list = await rpc('session.list', {});
  const items = list.items || [];
  if (!items.length) { console.log('(no sessions)'); return; }
  for (const s of items) {
    const flags = [s.running ? 'running' : 'idle', s.blank ? 'blank' : 'has-history'].join(',');
    console.log(`${s.sessionId}  (${flags})  ${s.cwd || ''}`);
  }
}

async function cmdRun(args) {
  const usage = 'usage: dsh-rpc run <task…|--task-file <f>> [--workspace <path>] [--permission <mode>] [--model <model>] [--no-wait] [--timeout <sec>] [--job-id <id>] [--json] [--poll-ms <ms>] [--create-workspace] [--require-title <title>]';
  const { opts, positional } = parseArgs(args, RUN_SPEC, usage);
  const wait = !opts.noWait;
  const quiet = !!opts.quiet;
  const timeoutMs = opts.timeout ? parseTimeoutSeconds(opts.timeout, '--timeout') : 10 * 60 * 1000;
  const task = await taskFromOptions(opts, positional.join(' '));
  if (!task) throw new Error(usage);
  if (opts.permission) checkPermissionAck(opts.permission, opts.allowDanger);
  const modelSel = buildModelSelection(opts.model || null, opts.provider || null, opts.reasoningEffort || null);

  const absPath = resolvePath(opts.workspace || null);
  const workspace = await ensureWorkspace(absPath, opts.createWorkspace);
  if (opts.requireTitle && workspace.title !== opts.requireTitle) {
    throw new Error(`workspace at ${absPath} has title "${workspace.title}", expected "${opts.requireTitle}"`);
  }

  const created = await rpc('session.create', { workspaceId: workspace.workspaceId });
  const sessionId = created.sessionId;
  if (!quiet) console.error(`session ${sessionId} in workspace "${workspace.title}" (${workspace.path})`);

  try {
    await runSession({
      sessionId, task, wait, quiet, permission: opts.permission || null, timeoutMs,
      model: modelSel, jobId: opts.jobId || null, json: !!opts.json,
      pollMs: opts.pollMs ? parsePollMs(opts.pollMs) : null,
      onIdle: (ev, j) => { if (j) console.log(JSON.stringify({ sessionId: ev.sessionId }, null, 2)); else console.log(ev.sessionId); },
    });
  } catch (e) {
    // this is a fresh session we created — cancel it so a failed run doesn't leave it running
    await cancelSession(sessionId).catch(() => {});
    throw e;
  }
}

async function cmdPrompt(args) {
  const usage = 'usage: dsh-rpc prompt <sessionId> [--wait] [--permission <mode>] [--model <model>] [--timeout <sec>] [--quiet] [--task-file <f>] [--job-id <id>] [--json] [--poll-ms <ms>] <text…>';
  const { opts, positional } = parseArgs(args, PROMPT_SPEC, usage);
  const wait = !!opts.wait;
  const quiet = !!opts.quiet;
  const timeoutMs = opts.timeout ? parseTimeoutSeconds(opts.timeout, '--timeout') : 10 * 60 * 1000;
  const sessionId = positional[0];
  const task = await taskFromOptions(opts, positional.slice(1).join(' '));
  if (!sessionId || !task) throw new Error(usage);
  if (opts.permission) checkPermissionAck(opts.permission, opts.allowDanger);
  const modelSel = buildModelSelection(opts.model || null, opts.provider || null, opts.reasoningEffort || null);
  // runSession does NOT cancel this session on error — it may pre-exist and
  // belong to prior work, unlike the fresh session created by `run`.
  await runSession({
    sessionId, task, wait, quiet, permission: opts.permission || null, timeoutMs,
    model: modelSel, jobId: opts.jobId || null, json: !!opts.json,
    pollMs: opts.pollMs ? parsePollMs(opts.pollMs) : null,
    onIdle: (ev, j) => { if (j) console.log(JSON.stringify({ sessionId: ev.sessionId, accepted: true }, null, 2)); else console.log(`accepted session ${ev.sessionId}`); },
  });
}

// CLI-level acknowledgement guard (no server call): the full-access preset is
// only reachable when the user passes --allow-danger-full-access. Whether the
// deployment actually offers the requested preset is validated against its
// `permissions` projection inside applyAndVerifyPermission.
function checkPermissionAck(permission, allowDangerFullAccess) {
  if (permission === 'danger-full-access' && !allowDangerFullAccess) {
    throw new Error('permission danger-full-access requires the explicit --allow-danger-full-access acknowledgement');
  }
}

// dsh-rpc fork <sessionId> [--at-seq <n>] [--model <model>] [--permission <mode>] [--no-wait] [--timeout <sec>] [<text…>]
// Branch an existing session via `session.fork` (the child keeps the parent's
// workspace grouping). With no text, print the child id and stop. With text,
// continue the child (same semantics as `run`, including cancel-on-error since
// the child is freshly created).
async function cmdFork(args) {
  const usage = 'usage: dsh-rpc fork <sessionId> [--at-seq <n>] [--permission <mode>] [--model <model>] [--no-wait] [--timeout <sec>] [--task-file <f>] [--job-id <id>] [--json] [--poll-ms <ms>] [<text…>]';
  const { opts, positional } = parseArgs(args, FORK_SPEC, usage);
  const wait = !opts.noWait;
  const quiet = !!opts.quiet;
  const timeoutMs = opts.timeout ? parseTimeoutSeconds(opts.timeout, '--timeout') : 10 * 60 * 1000;
  const sessionId = positional[0];
  const task = await taskFromOptions(opts, positional.slice(1).join(' '));
  if (!sessionId) throw new Error(usage);
  if (opts.permission) checkPermissionAck(opts.permission, opts.allowDanger);
  const modelSel = buildModelSelection(opts.model || null, opts.provider || null, opts.reasoningEffort || null);

  let atSeq;
  if (opts.atSeq !== undefined) {
    atSeq = Number(opts.atSeq);
    if (!Number.isInteger(atSeq) || atSeq < 0) throw new Error('--at-seq must be a non-negative integer');
  }

  const payload = { sessionId };
  if (atSeq !== undefined) payload.atSeq = atSeq;
  const child = await rpc('session.fork', payload);
  const childId = child.sessionId;
  if (!quiet) console.error(`forked ${sessionId} -> ${childId}`);

  if (!task) { if (opts.json) console.log(JSON.stringify({ sessionId: childId }, null, 2)); else console.log(childId); return; }

  try {
    await runSession({
      sessionId: childId, task, wait, quiet, permission: opts.permission || null, timeoutMs,
      model: modelSel, jobId: opts.jobId || null, json: !!opts.json,
      pollMs: opts.pollMs ? parsePollMs(opts.pollMs) : null,
      onIdle: (ev, j) => { if (j) console.log(JSON.stringify({ sessionId: ev.sessionId }, null, 2)); else console.log(ev.sessionId); },
    });
  } catch (e) {
    // the child is a session we just created — cancel it so a failed run doesn't leave it running
    await cancelSession(childId).catch(() => {});
    throw e;
  }
}

// dsh-rpc search <query> — search the deployment's session history.
async function cmdSearch(args) {
  const query = args.join(' ').trim();
  if (!query) throw new Error('usage: dsh-rpc search <query>');
  const res = await rpc('session.search', { query });
  const items = res.items || [];
  if (!items.length) { console.log('(no matches)'); return; }
  for (const it of items) console.log(`${it.sessionId}\t${it.snippet}`);
  if (res.hasMore) console.error('(more results available)');
}

async function cmdHistory(args) {
  const sessionId = args[0];
  if (!sessionId) throw new Error('usage: dsh-rpc history <sessionId>');
  const history = await getHistory(sessionId);
  for (const entry of history.events || []) {
    const ev = entry.event || entry;
    if (ev.type === 'user/message' && ev.data && ev.data.message) {
      console.log(`\n=== user ===\n${textOf(ev.data.message)}`);
    } else if (ev.type === 'assistant/message' && ev.data && ev.data.message) {
      const text = textOf(ev.data.message);
      if (text.trim() !== '') console.log(`\n=== assistant ===\n${text}`);
    } else if (ev.type === 'tool/result' && ev.data && ev.data.message) {
      console.log(`\n=== tool-result ===\n${textOf(ev.data.message).slice(0, 400)}`);
    }
  }
}

async function cmdCall(args) {
  const method = args[0];
  const payloadJson = args.slice(1).join(' ');
  if (!method) throw new Error('usage: dsh-rpc call <method> [json-payload]');
  let payload = {};
  if (payloadJson) {
    try { payload = JSON.parse(payloadJson); }
    catch (e) { throw new Error('payload must be valid JSON: ' + e.message); }
  }
  const value = await rpc(method, payload);
  console.log(JSON.stringify(value, null, 2));
}

async function cmdStatus(args) {
  const sessionId = args[0];
  if (!sessionId) throw new Error('usage: dsh-rpc status <sessionId>');
  const list = await rpc('session.list', {});
  const summary = (list.items || []).find((i) => i.sessionId === sessionId);
  const history = await getHistory(sessionId);
  const turnEnd = latestTurnEnd(history);
  const approval = pendingApproval(history);
  const text = finalAssistantText(history);
  const marker = findAnyJobMarker(text);
  const evidence = {
    sessionId,
    running: summary ? !!summary.running : null,
    permission: currentPermission(history) || null,
    pendingApproval: approval ? (approval.id || null) : null,
    turnEndReason: turnEnd && turnEnd.data && turnEnd.data.reason ? turnEnd.data.reason.kind : null,
    outcome: marker ? marker.kind : null,
    assistantText: text,
  };
  console.log(JSON.stringify(evidence, null, 2));
}

async function cmdCancel(args) {
  const sessionId = args[0];
  if (!sessionId) throw new Error('usage: dsh-rpc cancel <sessionId>');
  await cancelSession(sessionId);
  console.log(`cancelled session ${sessionId}`);
}

async function cmdVersion() {
  console.log(`${NAME} ${VERSION}`);
  console.log(REPO);
}

const HELP = `dsh-rpc — drive DeepSeek Harness (dsh) via its local /api RPC endpoint.

Usage:
  dsh-rpc workspaces                       list workspaces
  dsh-rpc sessions                         list sessions
  dsh-rpc run <task…|--task-file <f>>      create a grouped session, send task, wait, print result
       --workspace,-w <path>               target workspace dir (default: cwd)
       --permission,-p <mode>              set+verify session permission before the task
                                           (preset must be offered by the deployment; e.g. read-only)
       --allow-danger-full-access          required acknowledgement for danger-full-access
       --model <model>                     select the model: a bare id, or <provider>/<model>
       --provider <name>                   disambiguate --model across providers (optional)
       --reasoning-effort <id>             reasoning effort for --model (optional)
       --no-wait                           return the session id immediately
       --timeout <sec>                     max wait, then cancel (default 600)
       --task-file <path>                  read the task text from a file (mutually exclusive with positional text)
       --job-id <id>                       require a terminal marker DEEPSEEK_DONE/BLOCKED/NEEDS_INPUT:<id>
       --json                              emit structured JSON evidence instead of plain text
       --poll-ms <ms>                      override the completion polling interval
       --create-workspace                  create the workspace if missing (default: fail if missing)
       --require-title <title>             require the registered workspace title to match
       --                                  treat every following token as literal task text
       --quiet,-q                          suppress progress
  dsh-rpc prompt <sessionId> [opts] <text…>  send a prompt to an existing session
       --wait [--permission <mode>] [--model <model>] [--timeout <sec>] [--quiet]
       [--task-file <f>] [--job-id <id>] [--json] [--poll-ms <ms>]
  dsh-rpc fork <sessionId> [<text…>] [opts]  branch an existing session (child keeps workspace grouping)
       [--at-seq <n>] [--permission <mode>] [--model <model>] [--no-wait] [--timeout <sec>]
       [--task-file <f>] [--job-id <id>] [--json] [--poll-ms <ms>]
  dsh-rpc status <sessionId>               print structured JSON evidence about a session
  dsh-rpc cancel <sessionId>               explicitly cancel a session
  dsh-rpc search <query>                   search the deployment's session history
  dsh-rpc history <sessionId>              print a session's messages
  dsh-rpc call <method> [json]             raw RPC escape hatch (e.g. call session.list '{}')
  dsh-rpc version|--version|-V            print the version and repository

Env: DSH_URL (default http://127.0.0.1:3080), DSH_POLL_MS (default 1000)

Grouped-session guarantee: sessions are created through the same /api path the
web UI uses, so they appear under their workspace (not as "ungrouped").

Safety behavior: with --permission the preset is applied via commands/execute and
verified before the task is submitted; completion requires a turn/end with reason
"completed"; a pending approval, a timeout, a permission drift, or Ctrl-C cancels
the session instead of leaving it running.`;

async function main() {
  const [cmd, ...rest] = process.argv.slice(2);
  switch (cmd) {
    case 'workspaces': return cmdWorkspaces();
    case 'sessions': return cmdSessions();
    case 'run': return cmdRun(rest);
    case 'prompt': return cmdPrompt(rest);
    case 'fork': return cmdFork(rest);
    case 'search': return cmdSearch(rest);
    case 'history': return cmdHistory(rest);
    case 'call': return cmdCall(rest);
    case 'status': return cmdStatus(rest);
    case 'cancel': return cmdCancel(rest);
    case 'version': case '--version': case '-V': return cmdVersion();
    case 'help': case '--help': case '-h': case undefined:
      console.log(HELP); return;
    default:
      console.error(`unknown command: ${cmd}\n`);
      console.log(HELP);
      process.exitCode = 2;
  }
}

main().catch((err) => {
  console.error(`dsh-rpc error: ${err.message}`);
  process.exit(1);
});
