#!/usr/bin/env node
'use strict';

/*
 * dsh-rpc — drive the DeepSeek Harness (dsh) web-server /api RPC endpoint from the CLI.
 *
 * dsh's web UI is a React client over a local HTTP RPC bridge (`/api`) plus two
 * WebSocket downlinks. This tool talks to the same `/api` bridge directly, so
 * sessions it creates are GROUPED under a workspace exactly like ones created in
 * the web UI (unlike `dsh --profile headless`, which is always ungrouped).
 *
 * Transport (reverse-engineered from @deepseek-ai/dsh v0.1.0-rc.6):
 *   POST <BASE>/api/<method>
 *   Content-Type: application/json
 *   body: { "type":"client-request", "rpcId":<uuid>, "method":<method>, "payload":{...} }
 *   resp: { "type":"server-response", "rpcId":<uuid>,
 *           "result": { "ok":true, "value":... } | { "ok":false, "error":{code,message} } }
 *
 * The server enforces a browser-trust fence: the request Host must be a loopback
 * authority (127.0.0.1 / localhost) or a declared --trusted-host. Running locally,
 * plain fetch to 127.0.0.1 passes automatically. No auth layer exists (loopback only).
 *
 * Environment:
 *   DSH_URL       server base url        (default http://127.0.0.1:3080)
 *   DSH_POLL_MS   completion poll period (default 1000)
 *
 * This file is intentionally dependency-free and module-system agnostic
 * (no require/import, no top-level await) so it runs under either CJS or ESM.
 */

const BASE = process.env.DSH_URL || 'http://127.0.0.1:3080';
const POLL_MS = Number(process.env.DSH_POLL_MS || 1000);

function uuid() {
  const c = globalThis.crypto;
  if (c && typeof c.randomUUID === 'function') return c.randomUUID();
  return 'rpc-' + Date.now().toString(36) + '-' + Math.random().toString(36).slice(2, 10);
}

const sleep = (ms) => new Promise((r) => setTimeout(r, ms));

async function rpc(method, payload) {
  const rpcId = uuid();
  let res;
  try {
    res = await fetch(`${BASE}/api/${method}`, {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ type: 'client-request', rpcId, method, payload: payload || {} }),
    });
  } catch (e) {
    throw new Error(`cannot reach dsh at ${BASE} — is the web UI running? (${e.message})`);
  }
  if (!res.ok) {
    const text = (await res.text().catch(() => '')).slice(0, 200);
    throw new Error(`transport failure ${res.status} for ${method}${text ? ': ' + text : ''}`);
  }
  const full = await res.json();
  if (!full || !full.result) throw new Error(`malformed response for ${method}`);
  if (!full.result.ok) {
    const err = full.result.error || {};
    throw new Error(`${method} failed: ${err.code || 'unknown'}${err.message ? ': ' + err.message : ''}`);
  }
  return full.result.value;
}

/* ---- helpers ---- */

function resolvePath(p) {
  if (!p) return process.cwd();
  if (p === '~') return process.env.HOME;
  if (p.indexOf('~/') === 0) return process.env.HOME + p.slice(1);
  if (p.indexOf('/') === 0) return p;
  return process.cwd() + '/' + p;
}

function textOf(message) {
  const parts = [];
  for (const block of (message && message.content) || []) {
    if (block && block.type === 'text' && typeof block.text === 'string') parts.push(block.text);
  }
  return parts.join('\n');
}

async function listWorkspaces() {
  return (await rpc('workspace.list', {})).items || [];
}

async function findWorkspaceByPath(absPath) {
  const items = await listWorkspaces();
  return items.find((w) => w.path === absPath);
}

async function ensureWorkspace(absPath) {
  const existing = await findWorkspaceByPath(absPath);
  if (existing) return existing;
  const created = await rpc('workspace.create', { path: absPath });
  return created.workspace;
}

async function getHistory(sessionId) {
  return rpc('session.history', { sessionId, maxMessages: 200 });
}

function finalAssistantText(history) {
  const events = (history && history.events) || [];
  // walk newest-to-oldest; return the last assistant message that has visible text
  for (let i = events.length - 1; i >= 0; i--) {
    const ev = events[i].event || events[i];
    if (ev.type === 'assistant/message' && ev.data && ev.data.message) {
      const text = textOf(ev.data.message);
      if (text.trim() !== '') return text;
    }
  }
  return '';
}

async function waitForCompletion(sessionId, timeoutMs, quiet) {
  const deadline = Date.now() + timeoutMs;
  const start = Date.now();
  let sawRunning = false;
  while (Date.now() < deadline) {
    let summary;
    try {
      const list = await rpc('session.list', {});
      summary = (list.items || []).find((i) => i.sessionId === sessionId);
    } catch (e) {
      /* transient server hiccup — keep polling */
    }
    if (summary && summary.running) sawRunning = true;
    const graceDone = sawRunning || (Date.now() - start > 3000);
    if (summary && summary.running === false && graceDone) return;
    if (!quiet) {
      const secs = Math.round((Date.now() - start) / 1000);
      process.stderr.write(`\r  dsh working… ${secs}s${summary && summary.running ? ' (running)' : ''}   `);
    }
    await sleep(POLL_MS);
  }
  throw new Error(`timed out after ${timeoutMs}ms waiting for session ${sessionId}`);
}

/* ---- commands ---- */

async function cmdWorkspaces() {
  const items = await listWorkspaces();
  if (!items.length) { console.log('(no workspaces)'); return; }
  for (const w of items) {
    console.log(`${w.workspaceId}  ${w.title}  [${w.sessionIds.length} sessions]  ${w.path}`);
  }
}

async function cmdSessions() {
  const list = await rpc('session.list', {});
  const items = list.items || [];
  if (!items.length) { console.log('(no sessions)'); return; }
  for (const s of items) {
    const flags = [s.running ? 'running' : 'idle', s.blank ? 'blank' : 'has-history'].join(',');
    console.log(`${s.sessionId}  (${flags})  ${s.cwd || ''}`);
  }
}

async function cmdRun(args) {
  // parse flags
  let workspacePath = null;
  let wait = true;
  let quiet = false;
  let timeoutMs = 10 * 60 * 1000;
  const taskParts = [];
  for (let i = 0; i < args.length; i++) {
    const a = args[i];
    if (a === '--workspace' || a === '-w') { workspacePath = args[++i]; }
    else if (a === '--no-wait') { wait = false; }
    else if (a === '--quiet' || a === '-q') { quiet = true; }
    else if (a === '--timeout') { timeoutMs = Number(args[++i]) * 1000; }
    else { taskParts.push(a); }
  }
  const task = taskParts.join(' ').trim();
  if (!task) throw new Error('usage: dsh-rpc run <task…> [--workspace <path>] [--no-wait] [--timeout <sec>]');

  const absPath = resolvePath(workspacePath);
  const workspace = await ensureWorkspace(absPath);

  const created = await rpc('session.create', { workspaceId: workspace.workspaceId });
  const sessionId = created.sessionId;
  if (!quiet) console.error(`session ${sessionId} in workspace "${workspace.title}" (${workspace.path})`);

  await rpc('session.prompt', {
    sessionId,
    mode: 'queue',
    content: [{ type: 'text', text: task }],
  });

  if (!wait) {
    console.log(sessionId);
    return;
  }

  await waitForCompletion(sessionId, timeoutMs, quiet);
  if (!quiet) process.stderr.write('\n');
  const history = await getHistory(sessionId);
  const text = finalAssistantText(history);
  console.log(text || '(no assistant text captured — use `dsh-rpc history ' + sessionId + '`)');
  console.error(`\n[done] session ${sessionId}`);
}

async function cmdPrompt(args) {
  let wait = false;
  let quiet = false;
  let timeoutMs = 10 * 60 * 1000;
  const rest = [];
  for (let i = 0; i < args.length; i++) {
    const a = args[i];
    if (a === '--wait') { wait = true; }
    else if (a === '--quiet' || a === '-q') { quiet = true; }
    else if (a === '--timeout') { timeoutMs = Number(args[++i]) * 1000; }
    else { rest.push(a); }
  }
  const sessionId = rest[0];
  const text = rest.slice(1).join(' ').trim();
  if (!sessionId || !text) throw new Error('usage: dsh-rpc prompt <sessionId> [--wait] [--timeout <sec>] [--quiet] <text…>');
  await rpc('session.prompt', {
    sessionId,
    mode: 'queue',
    content: [{ type: 'text', text }],
  });
  if (!wait) {
    console.log(`accepted session ${sessionId}`);
    return;
  }
  await waitForCompletion(sessionId, timeoutMs, quiet);
  if (!quiet) process.stderr.write('\n');
  const history = await getHistory(sessionId);
  console.log(finalAssistantText(history) || '(no assistant text captured — use `dsh-rpc history ' + sessionId + '`)');
  console.error(`\n[done] session ${sessionId}`);
}

async function cmdHistory(args) {
  const sessionId = args[0];
  if (!sessionId) throw new Error('usage: dsh-rpc history <sessionId>');
  const history = await getHistory(sessionId);
  for (const entry of history.events || []) {
    const ev = entry.event || entry;
    if (ev.type === 'user/message' && ev.data && ev.data.message) {
      console.log(`\n=== user ===\n${textOf(ev.data.message)}`);
    } else if (ev.type === 'assistant/message' && ev.data && ev.data.message) {
      const text = textOf(ev.data.message);
      if (text.trim() !== '') console.log(`\n=== assistant ===\n${text}`);
    } else if (ev.type === 'tool/result' && ev.data && ev.data.message) {
      console.log(`\n=== tool-result ===\n${textOf(ev.data.message).slice(0, 400)}`);
    }
  }
}

async function cmdCall(args) {
  const method = args[0];
  const payloadJson = args.slice(1).join(' ');
  if (!method) throw new Error('usage: dsh-rpc call <method> [json-payload]');
  let payload = {};
  if (payloadJson) {
    try { payload = JSON.parse(payloadJson); }
    catch (e) { throw new Error('payload must be valid JSON: ' + e.message); }
  }
  const value = await rpc(method, payload);
  console.log(JSON.stringify(value, null, 2));
}

const HELP = `dsh-rpc — drive DeepSeek Harness (dsh) via its local /api RPC endpoint.

Usage:
  dsh-rpc workspaces                       list workspaces
  dsh-rpc sessions                         list sessions
  dsh-rpc run <task…> [opts]               create a grouped session, send task, wait, print result
       --workspace,-w <path>               target workspace dir (default: cwd)
       --no-wait                           return the session id immediately
       --timeout <sec>                     max wait (default 600)
       --quiet,-q                          suppress progress
  dsh-rpc prompt <sessionId> <text…>       send a prompt to an existing session
  dsh-rpc history <sessionId>              print a session's messages
  dsh-rpc call <method> [json]             raw RPC escape hatch (e.g. call session.list '{}')

Env: DSH_URL (default http://127.0.0.1:3080), DSH_POLL_MS (default 1000)

Grouped-session guarantee: sessions are created through the same /api path the
web UI uses, so they appear under their workspace (not as "ungrouped").`;

async function main() {
  const [cmd, ...rest] = process.argv.slice(2);
  switch (cmd) {
    case 'workspaces': return cmdWorkspaces();
    case 'sessions': return cmdSessions();
    case 'run': return cmdRun(rest);
    case 'prompt': return cmdPrompt(rest);
    case 'history': return cmdHistory(rest);
    case 'call': return cmdCall(rest);
    case 'help': case '--help': case '-h': case undefined:
      console.log(HELP); return;
    default:
      console.error(`unknown command: ${cmd}\n`);
      console.log(HELP);
      process.exitCode = 2;
  }
}

main().catch((err) => {
  console.error(`dsh-rpc error: ${err.message}`);
  process.exit(1);
});
