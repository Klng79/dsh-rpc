browser-session signing secret; falls back to ~/.dsh/.credentials.yaml as
written by \`dsh web\`), DSH_POLL_MS (default 1000)

Requires Node >= 22 (built-in WebSocket for the /api/remote.mux stream mux).

Grouped-session guarantee: sessions are created through the same /api path the
web UI uses, so they appear under their workspace (not as "ungrouped").

Safety behavior: with --permission the preset is applied via commands/execute and
verified before the task is submitted; completion requires a turn/end with reason
"completed"; a pending approval, a timeout, a permission drift, or Ctrl-C cancels
the session instead of leaving it running.`;

async function main() {
  const [cmd, ...rest] = process.argv.slice(2);
  switch (cmd) {
    case 'workspaces': return cmdWorkspaces();
    case 'sessions': return cmdSessions();
    case 'run': return cmdRun(rest);
    case 'prompt': return cmdPrompt(rest);
    case 'fork': return cmdFork(rest);
    case 'search': return cmdSearch(rest);
    case 'history': return cmdHistory(rest);
    case 'call': return cmdCall(rest);
    case 'status': return cmdStatus(rest);
    case 'cancel': return cmdCancel(rest);
    case 'version': case '--version': case '-V': return cmdVersion();
    case 'help': case '--help': case '-h': case undefined:
      console.log(HELP); return;
    default:
      console.error(`unknown command: ${cmd}\n`);
      console.log(HELP);
      process.exitCode = 2;
  }
}

// End of command: the shared mux WebSocket keeps the Node event loop alive,
// so close it explicitly — otherwise every command would hang after printing.
async function closeMux() {
  const ws = muxSocket;
  resetMux();
  failMuxOpeners('mux connection closed by CLI');
  if (ws) {
    try { ws.close(); } catch { /* already closing/closed */ }
  }
}

main()
  .then(closeMux, (err) => {
    console.error(`dsh-rpc error: ${err.message}`);
    process.exit(1);
  });
