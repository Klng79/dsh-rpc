#!/usr/bin/env node
'use strict';

/*
 * dsh-rpc — drive the DeepSeek Harness (dsh) web-server /api RPC endpoint from the CLI.
 *
 * dsh's web UI is a React client over a local HTTP RPC bridge (`/api`) plus two
 * WebSocket downlinks. This tool talks to the same `/api` bridge directly, so
 * sessions it creates are GROUPED under a workspace exactly like ones created in
 * the web UI (unlike `dsh --profile headless`, which is always ungrouped).
 *
 * Transport (reverse-engineered from @deepseek-ai/dsh v0.1.0-rc.6):
 *   POST <BASE>/api/<method>
 *   Content-Type: application/json
 *   body: { "type":"client-request", "rpcId":<uuid>, "method":<method>, "payload":{...} }
 *   resp: { "type":"server-response", "rpcId":<uuid>,
 *           "result": { "ok":true, "value":... } | { "ok":false, "error":{code,message} } }
 *
 * The server enforces a browser-trust fence: the request Host must be a loopback
 * authority (127.0.0.1 / localhost) or a declared --trusted-host. Running locally,
 * plain fetch to 127.0.0.1 passes automatically. No auth layer exists (loopback only).
 *
 * Safety features adapted from jnsys's guarded-runner proposal
 * (https://github.com/jnsys/dsh-rpc, PR on Klng79/dsh-rpc): permission is set via
 * the `commands/execute` RPC + verified against the `permissions` projection;
 * completion requires a `turn/end` with reason "completed"; pending approvals and
 * timeouts cancel the session instead of leaving it running.
 *
 * Environment:
 *   DSH_URL       server base url        (default http://127.0.0.1:3080)
 *   DSH_POLL_MS   completion poll period (default 1000)
 *
 * This file is intentionally dependency-free and module-system agnostic
 * (no require/import, no top-level await) so it runs under either CJS or ESM.
 */

const BASE = (process.env.DSH_URL || 'http://127.0.0.1:3080').replace(/\/+$/, '');
const POLL_MS = Number(process.env.DSH_POLL_MS || 1000);
const BUILD_ID = 'jnsys-guarded-2';
const SOURCE_URL = 'https://github.com/jnsys/dsh-rpc';
// Per-request timeout for the /api bridge. dsh's server does its long-running
// work asynchronously, so a single request should never take more than this;
// it exists to keep a hung server from trapping the CLI forever. Override with
// DSH_RPC_TIMEOUT_MS.
const RPC_TIMEOUT_MS = Number(process.env.DSH_RPC_TIMEOUT_MS || 30000);

function uuid() {
  const c = globalThis.crypto;
  if (c && typeof c.randomUUID === 'function') return c.randomUUID();
  return 'rpc-' + Date.now().toString(36) + '-' + Math.random().toString(36).slice(2, 10);
}

const sleep = (ms) => new Promise((r) => setTimeout(r, ms));

// While a session is being waited on, SIGINT (Ctrl-C) cancels it instead of
// leaving it running unattended — matching the tool's cancel-on-approval /
// cancel-on-timeout safety behavior. cancelSession is declared below; the
// handler only runs after module load, so hoisting covers it.
let activeSession = null;
let cancelInFlight = false;

process.on('SIGINT', () => {
  const id = activeSession;
  activeSession = null;
  process.stderr.write('\ninterrupted — cancelling session' + (id ? ' ' + id : '') + '\n');
  process.exitCode = 130;
  // No active session: nothing to cancel, exit now. A second Ctrl-C while a
  // cancel is already in flight force-exits — the user clearly wants out now.
  if (!id || cancelInFlight) { process.exit(130); return; }
  cancelInFlight = true;
  // process.exit() drops pending async I/O, so the fire-and-forget cancel
  // would almost never be sent. Await the cancel (bounded, so a hung server
  // can't trap the user forever) before exiting with the documented 130 code.
  Promise.race([cancelSession(id), sleep(2000)])
    .catch(() => {})
    .finally(() => process.exit(130));
});

async function rpc(method, payload) {
  const rpcId = uuid();
  const controller = new AbortController();
  const timer = setTimeout(() => controller.abort(), RPC_TIMEOUT_MS);
  try {
    let res;
    try {
      res = await fetch(`${BASE}/api/${method}`, {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ type: 'client-request', rpcId, method, payload: payload || {} }),
        signal: controller.signal,
      });
    } catch (e) {
      if (controller.signal.aborted) {
        throw new Error(`request to ${method} timed out after ${RPC_TIMEOUT_MS}ms`);
      }
      throw new Error(`cannot reach dsh at ${BASE} — is the web UI running? (${e.message})`);
    }
    if (!res.ok) {
      const text = (await res.text().catch(() => '')).slice(0, 200);
      throw new Error(`transport failure ${res.status} for ${method}${text ? ': ' + text : ''}`);
    }
    const full = await res.json();
    if (!full || full.type !== 'server-response' || full.rpcId !== rpcId || !full.result) {
      throw new Error(`malformed or mismatched response for ${method}`);
    }
    if (!full.result.ok) {
      const err = full.result.error || {};
      throw new Error(`${method} failed: ${err.code || 'unknown'}${err.message ? ': ' + err.message : ''}`);
    }
    return full.result.value;
  } finally {
    clearTimeout(timer);
  }
}

/* ---- helpers ---- */

function resolvePath(p) {
  let value = p || process.cwd();
  if (value === '~') value = process.env.HOME;
  else if (value.indexOf('~/') === 0) value = process.env.HOME + value.slice(1);
  else if (value.indexOf('/') !== 0) value = process.cwd() + '/' + value;
  const normalized = [];
  for (const part of value.split('/')) {
    if (!part || part === '.') continue;
    if (part === '..') normalized.pop();
    else normalized.push(part);
  }
  return '/' + normalized.join('/');
}

// Return the value that follows a --flag at args[flagIndex], or throw a clear
// error if the flag is the last argument or the next token looks like a flag.
function nextValue(args, flagIndex, flag) {
  const v = args[flagIndex + 1];
  if (v === undefined || (v.length > 0 && v[0] === '-' && v !== '-')) {
    throw new Error(`${flag} requires a value`);
  }
  return v;
}

function parseTimeoutSeconds(v, flag) {
  const n = Number(v);
  if (!Number.isFinite(n) || n <= 0) {
    throw new Error(`${flag} must be a positive number of seconds`);
  }
  return n * 1000;
}

function textOf(message) {
  const parts = [];
  for (const block of (message && message.content) || []) {
    if (block && block.type === 'text' && typeof block.text === 'string') parts.push(block.text);
  }
  return parts.join('\n');
}

async function listWorkspaces() {
  return (await rpc('workspace.list', {})).items || [];
}

async function findWorkspaceByPath(absPath) {
  const items = await listWorkspaces();
  return items.find((w) => resolvePath(w.path) === absPath);
}

async function requireWorkspace(absPath, requireTitle, createWorkspace) {
  const existing = await findWorkspaceByPath(absPath);
  if (existing) {
    if (requireTitle && existing.title !== requireTitle) {
      throw new Error(`workspace title mismatch: expected ${JSON.stringify(requireTitle)}, got ${JSON.stringify(existing.title)}`);
    }
    return existing;
  }
  if (!createWorkspace) {
    throw new Error(`required workspace is not registered: ${absPath}; pass --create-workspace to create it explicitly`);
  }
  const created = await rpc('workspace.create', { path: absPath });
  return created.workspace;
}

async function getHistory(sessionId) {
  return rpc('session.history', { sessionId, maxMessages: 200 });
}

function eventSequence(entry) {
  const values = [entry && entry.seq, entry && entry.sequence, entry && entry.event && entry.event.seq];
  return values.find((value) => Number.isFinite(value));
}

function historyCheckpoint(history) {
  const events = (history && history.events) || [];
  let maxSeq;
  for (const entry of events) {
    const seq = eventSequence(entry);
    if (seq !== undefined && (maxSeq === undefined || seq > maxSeq)) maxSeq = seq;
  }
  return { length: events.length, maxSeq };
}

function isAfterCheckpoint(entry, index, checkpoint) {
  if (!checkpoint) return true;
  const seq = eventSequence(entry);
  if (checkpoint.maxSeq !== undefined && seq !== undefined) return seq > checkpoint.maxSeq;
  return index >= checkpoint.length;
}

function finalAssistantText(history, checkpoint) {
  const events = (history && history.events) || [];
  // walk newest-to-oldest; return the last assistant message that has visible text
  for (let i = events.length - 1; i >= 0; i--) {
    if (!isAfterCheckpoint(events[i], i, checkpoint)) continue;
    const ev = events[i].event || events[i];
    if (ev.type === 'assistant/message' && ev.data && ev.data.message) {
      const text = textOf(ev.data.message);
      if (text.trim() !== '') return text;
    }
  }
  return '';
}

/* ---- safety helpers (adapted from jnsys's guarded-runner) ---- */

function currentPermission(history) {
  const proj = history && history.projections && history.projections.values && history.projections.values.permissions;
  if (proj && typeof proj.currentValue === 'string') return proj.currentValue;
  const events = (history && history.events) || [];
  for (let i = events.length - 1; i >= 0; i--) {
    const ev = events[i].event || events[i];
    if (ev.type === 'permission/preset' && ev.data && typeof ev.data.preset === 'string') return ev.data.preset;
  }
  return undefined;
}

function latestTurnEnd(history, checkpoint) {
  const events = (history && history.events) || [];
  for (let i = events.length - 1; i >= 0; i--) {
    if (!isAfterCheckpoint(events[i], i, checkpoint)) continue;
    const ev = events[i].event || events[i];
    if (ev.type === 'turn/end') return ev;
  }
  return undefined;
}

function pendingApproval(history) {
  const pending = new Map();
  for (const entry of (history && history.events) || []) {
    const ev = entry.event || entry;
    if (ev.type === 'approval/asked' && ev.data && ev.data.id) pending.set(ev.data.id, ev.data);
    else if (ev.type === 'approval/decided' && ev.data && ev.data.id) pending.delete(ev.data.id);
  }
  const first = pending.values().next();
  return first.done ? undefined : first.value;
}

function markerOutcome(text, jobId) {
  if (!jobId) return undefined;
  const escaped = jobId.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
  const match = text.match(new RegExp(`(?:^|\\n)DEEPSEEK_(DONE|BLOCKED|NEEDS_INPUT):${escaped}\\s*$`));
  return match && match[1];
}

function cancelSession(sessionId) {
  return rpc('session.cancel', { sessionId });
}

// Extract the preset names a deployment actually offers, from the session's
// `permissions` projection (projections.values.permissions.options). Tolerates
// options being an array of strings or of objects ({name|value|id|key}).
function permissionPresetNames(history) {
  const proj = history && history.projections && history.projections.values && history.projections.values.permissions;
  const options = proj && proj.options;
  if (!Array.isArray(options)) return [];
  const names = [];
  for (const o of options) {
    if (typeof o === 'string') { if (o) names.push(o); }
    else if (o && typeof o === 'object') {
      const n = o.name || o.value || o.id || o.key;
      if (typeof n === 'string' && n) names.push(n);
    }
  }
  return names;
}

async function applyAndVerifyPermission(sessionId, permission) {
  // Deployment-level check: only accept presets this deployment actually offers.
  // If the projection exposes no options we skip the pre-check and rely on the
  // verify step below (a wrong preset still fails verification).
  const history = await getHistory(sessionId);
  const names = permissionPresetNames(history);
  if (names.length && !names.includes(permission)) {
    throw new Error(`permission "${permission}" is not offered by this deployment; available: ${names.join(', ')}`);
  }
  const exec = await rpc('commands/execute', {
    args: { agentId: sessionId, line: `/permission ${permission}` },
  });
  if (!exec || !exec.result || exec.result.kind !== 'success') {
    const detail = exec && exec.result && exec.result.text ? `: ${exec.result.text}` : '';
    throw new Error(`could not set permission "${permission}" for ${sessionId}${detail}`);
  }
  const verified = await getHistory(sessionId);
  const actual = currentPermission(verified);
  if (actual !== permission) {
    throw new Error(`permission verification failed for ${sessionId}: expected ${permission}, got ${actual || 'unknown'}`);
  }
}

// Build a `{ provider?, model, reasoningEffort? }` selection from the CLI flags.
// `--model` accepts either a bare model id (disambiguated against the catalog)
// or a `provider/model` pair; `--provider`/`--reasoning-effort` are optional
// disambiguators/overrides. Returns null when nothing model-related was given.
function buildModelSelection(model, provider, reasoningEffort) {
  if (model === null && provider === null && reasoningEffort === null) return null;
  if (model === null) throw new Error('--provider requires --model');
  let m = model;
  let p = provider;
  if (p === null && model.includes('/')) {
    const idx = model.lastIndexOf('/');
    p = model.slice(0, idx) || null;
    m = model.slice(idx + 1);
    if (!p) throw new Error(`invalid --model "${model}": missing provider before "/"`);
  }
  if (!m) throw new Error('--model requires a model id');
  return { model: m, provider: p || undefined, reasoningEffort: reasoningEffort || undefined };
}

// One `provider/model` string per catalog entry, for error/discovery messages.
function describeModels(cat) {
  const groups = cat && cat.groups ? cat.groups : [];
  const parts = [];
  for (const g of groups) {
    for (const m of (g.models || [])) parts.push(`${g.id}/${m.id}`);
  }
  return parts.join(', ') || '(none loaded)';
}

// Apply a model selection to a session: fetch the catalog (`session.models`),
// resolve a bare model id against it (or fill a default reasoning effort), then
// commit via `session.selectModel`. selectModel is authoritative, but resolving
// here gives clear errors and avoids guessing at provider/model ids.
async function applyModelSelection(sessionId, model) {
  const cat = await rpc('session.models', { sessionId });
  let provider = model.provider;
  if (!provider) {
    const matches = [];
    for (const g of (cat.groups || [])) {
      for (const m of (g.models || [])) if (m.id === model.model) matches.push(g.id);
    }
    if (matches.length === 1) provider = matches[0];
    else if (matches.length === 0) {
      throw new Error(`model "${model.model}" not found for ${sessionId}; available: ${describeModels(cat)}`);
    } else {
      throw new Error(`model "${model.model}" is offered by multiple providers (${matches.join(', ')}); pass --provider to disambiguate`);
    }
  }
  const group = (cat.groups || []).find((g) => g.id === provider);
  const entry = group && (group.models || []).find((mm) => mm.id === model.model);
  if (!entry) throw new Error(`model "${provider}/${model.model}" not found for ${sessionId}; available: ${describeModels(cat)}`);
  let reasoningEffort = model.reasoningEffort;
  if (!reasoningEffort && entry.reasoning && entry.reasoning.defaultEffort) reasoningEffort = entry.reasoning.defaultEffort;
  const payload = { sessionId, provider, model: model.model };
  if (reasoningEffort) payload.reasoningEffort = reasoningEffort;
  await rpc('session.selectModel', payload);
}

async function waitForCompletion(sessionId, options, checkpoint) {
  const deadline = Date.now() + options.timeoutMs;
  const start = Date.now();
  while (Date.now() < deadline) {
    const list = await rpc('session.list', {});
    const summary = (list.items || []).find((i) => i.sessionId === sessionId);
    if (!summary) throw new Error(`session disappeared while monitoring: ${sessionId}`);
    const history = await getHistory(sessionId);
    const approval = pendingApproval(history);
    if (approval) {
      await cancelSession(sessionId).catch(() => {});
      throw new Error(`session requested approval for ${approval.toolName || 'an operation'}; cancelled`);
    }
    const actualPermission = currentPermission(history);
    if (actualPermission !== options.permission) {
      await cancelSession(sessionId).catch(() => {});
      throw new Error(`permission changed while running: expected ${options.permission}, got ${actualPermission || 'unknown'}`);
    }
    const turnEnd = latestTurnEnd(history, checkpoint);
    if (summary.running === false && turnEnd) {
      const kind = turnEnd && turnEnd.data && turnEnd.data.reason ? turnEnd.data.reason.kind : undefined;
      if (kind !== 'completed') {
        throw new Error(`session ended with reason "${kind || 'unknown'}" (not completed)`);
      }
      const assistantText = finalAssistantText(history, checkpoint);
      const outcome = markerOutcome(assistantText, options.jobId);
      if (options.jobId && !outcome) {
        throw new Error(`protocol failure: final assistant response lacks a matching marker for ${options.jobId}`);
      }
      return {
        sessionId,
        running: false,
        elapsedMs: Date.now() - start,
        permission: actualPermission,
        turnEndReason: kind,
        outcome: outcome || null,
        assistantText,
      };
    }
    if (!options.quiet) {
      const secs = Math.round((Date.now() - start) / 1000);
      process.stderr.write(`\r  dsh working… ${secs}s${summary.running ? ' (running)' : ' (queued)'}   `);
    }
    await sleep(options.pollMs);
  }
  await cancelSession(sessionId).catch(() => {});
  throw new Error(`timed out after ${options.timeoutMs}ms; cancelled session ${sessionId}`);
}

// Shared core for `run`, `prompt --wait` and `fork --no-wait`/text: apply the
// model selection (if requested), set+verify the permission (if requested),
// enqueue the prompt, then return admission evidence immediately or wait for
// strict completion evidence. Whether to cancel on a later caller-level error
// is left to the caller: `run`/`fork` own fresh sessions, while `prompt` may
// target a pre-existing session.
async function runSession({ sessionId, task, wait, quiet, permission, timeoutMs, pollMs, model, jobId }) {
  activeSession = sessionId;
  try {
    await applyAndVerifyPermission(sessionId, permission);
    if (!quiet) console.error(`verified permission ${permission}`);
    if (model) {
      await applyModelSelection(sessionId, model);
      if (!quiet) console.error(`selected model ${model.provider ? model.provider + '/' : ''}${model.model}`);
    }
    const beforePrompt = await getHistory(sessionId);
    const checkpoint = historyCheckpoint(beforePrompt);
    const accepted = await rpc('session.prompt', {
      sessionId,
      mode: 'queue',
      content: [{ type: 'text', text: task }],
    });
    if (!accepted || accepted.accepted !== true) {
      throw new Error(`Harness did not accept the task for ${sessionId}`);
    }
    if (!wait) {
      return { sessionId, permission, accepted: true };
    }
    const result = await waitForCompletion(sessionId, { timeoutMs, pollMs, quiet, permission, jobId }, checkpoint);
    if (!quiet) process.stderr.write('\n');
    return result;
  } finally {
    activeSession = null;
  }
}

/* ---- commands ---- */

async function readTaskFile(file) {
  const fs = await import('node:fs/promises');
  return (await fs.readFile(file, 'utf8')).trim();
}

function printResult(result, json, fallback) {
  console.log(json ? JSON.stringify(result, null, 2) : fallback);
}

function parseDisplayMode(args, command) {
  let table = false;
  for (const arg of args) {
    if (arg === '--table') table = true;
    else if (arg === '--json') table = false;
    else throw new Error(`unknown ${command} option: ${arg}`);
  }
  return table;
}

async function cmdWorkspaces(args) {
  const items = await listWorkspaces();
  if (!parseDisplayMode(args, 'workspaces')) {
    console.log(JSON.stringify(items, null, 2));
    return;
  }
  if (!items.length) { console.log('(no workspaces)'); return; }
  for (const w of items) {
    console.log(`${w.workspaceId}  ${w.title}  [${w.sessionIds.length} sessions]  ${w.path}`);
  }
}

async function cmdSessions(args) {
  const list = await rpc('session.list', {});
  const items = list.items || [];
  if (!parseDisplayMode(args, 'sessions')) {
    console.log(JSON.stringify(items, null, 2));
    return;
  }
  if (!items.length) { console.log('(no sessions)'); return; }
  for (const s of items) {
    const flags = [s.running ? 'running' : 'idle', s.blank ? 'blank' : 'has-history'].join(',');
    console.log(`${s.sessionId}  (${flags})  ${s.cwd || ''}`);
  }
}

async function cmdRun(args) {
  let workspacePath = null;
  let requireTitle;
  let createWorkspace = false;
  let wait = true;
  let quiet = false;
  let json = false;
  let permission = 'read-only';
  let allowDangerFullAccess = false;
  let timeoutMs = 10 * 60 * 1000;
  let pollMs = POLL_MS;
  let model = null;
  let modelProvider = null;
  let reasoningEffort = null;
  let jobId;
  let taskFile;
  const taskParts = [];
  let literal = false;
  for (let i = 0; i < args.length; i++) {
    const a = args[i];
    if (literal) { taskParts.push(a); continue; }
    if (a === '--') { literal = true; }
    else if (a === '--workspace' || a === '-w') { workspacePath = nextValue(args, i, '--workspace'); i++; }
    else if (a === '--require-title') { requireTitle = nextValue(args, i, '--require-title'); i++; }
    else if (a === '--create-workspace') { createWorkspace = true; }
    else if (a === '--permission' || a === '-p') { permission = nextValue(args, i, '--permission'); i++; }
    else if (a === '--allow-danger-full-access') { allowDangerFullAccess = true; }
    else if (a === '--no-wait') { wait = false; }
    else if (a === '--quiet' || a === '-q') { quiet = true; }
    else if (a === '--json') { json = true; }
    else if (a === '--timeout') { timeoutMs = parseTimeoutSeconds(nextValue(args, i, '--timeout'), '--timeout'); i++; }
    else if (a === '--poll-ms') { pollMs = Number(nextValue(args, i, '--poll-ms')); if (!Number.isFinite(pollMs) || pollMs <= 0) throw new Error('--poll-ms must be a positive number'); i++; }
    else if (a === '--model') { model = nextValue(args, i, '--model'); i++; }
    else if (a === '--provider') { modelProvider = nextValue(args, i, '--provider'); i++; }
    else if (a === '--reasoning-effort') { reasoningEffort = nextValue(args, i, '--reasoning-effort'); i++; }
    else if (a === '--job-id') { jobId = nextValue(args, i, '--job-id'); i++; }
    else if (a === '--task-file') { taskFile = nextValue(args, i, '--task-file'); i++; }
    else if (a.startsWith('-')) { throw new Error(`unknown option: ${a}`); }
    else { taskParts.push(a); }
  }
  if (taskFile && taskParts.length) throw new Error('use either task text or --task-file, not both');
  const task = taskFile ? await readTaskFile(taskFile) : taskParts.join(' ').trim();
  if (!task) throw new Error('usage: dsh-rpc run <task…> [--workspace <path>] [--permission <mode>] [--model <model>] [--no-wait] [--timeout <sec>]');
  checkPermissionAck(permission, allowDangerFullAccess);
  const modelSel = buildModelSelection(model, modelProvider, reasoningEffort);

  const absPath = resolvePath(workspacePath);
  const workspace = await requireWorkspace(absPath, requireTitle, createWorkspace);

  const created = await rpc('session.create', { workspaceId: workspace.workspaceId });
  const sessionId = created.sessionId;
  if (!quiet) console.error(`session ${sessionId} in workspace "${workspace.title}" (${workspace.path})`);

  try {
    const result = await runSession({ sessionId, task, wait, quiet, permission, timeoutMs, pollMs, model: modelSel, jobId });
    const output = { ...result, workspace: workspace.title };
    printResult(output, json, wait ? (result.assistantText || `(no assistant text captured — use \`dsh-rpc history ${sessionId}\`)`) : sessionId);
    if (result.outcome === 'BLOCKED') process.exitCode = 3;
    if (result.outcome === 'NEEDS_INPUT') process.exitCode = 4;
  } catch (e) {
    // this is a fresh session we created — cancel it so a failed run doesn't leave it running
    await cancelSession(sessionId).catch(() => {});
    throw e;
  }
}

async function cmdPrompt(args) {
  let wait = false;
  let quiet = false;
  let json = false;
  let permission = 'read-only';
  let allowDangerFullAccess = false;
  let timeoutMs = 10 * 60 * 1000;
  let pollMs = POLL_MS;
  let model = null;
  let modelProvider = null;
  let reasoningEffort = null;
  let jobId;
  const rest = [];
  let literal = false;
  for (let i = 0; i < args.length; i++) {
    const a = args[i];
    if (literal) { rest.push(a); continue; }
    if (a === '--') { literal = true; }
    else if (a === '--wait') { wait = true; }
    else if (a === '--permission' || a === '-p') { permission = nextValue(args, i, '--permission'); i++; }
    else if (a === '--allow-danger-full-access') { allowDangerFullAccess = true; }
    else if (a === '--quiet' || a === '-q') { quiet = true; }
    else if (a === '--json') { json = true; }
    else if (a === '--timeout') { timeoutMs = parseTimeoutSeconds(nextValue(args, i, '--timeout'), '--timeout'); i++; }
    else if (a === '--poll-ms') { pollMs = Number(nextValue(args, i, '--poll-ms')); if (!Number.isFinite(pollMs) || pollMs <= 0) throw new Error('--poll-ms must be a positive number'); i++; }
    else if (a === '--model') { model = nextValue(args, i, '--model'); i++; }
    else if (a === '--provider') { modelProvider = nextValue(args, i, '--provider'); i++; }
    else if (a === '--reasoning-effort') { reasoningEffort = nextValue(args, i, '--reasoning-effort'); i++; }
    else if (a === '--job-id') { jobId = nextValue(args, i, '--job-id'); i++; }
    else if (a.startsWith('-')) { throw new Error(`unknown option: ${a}`); }
    else { rest.push(a); }
  }
  const sessionId = rest[0];
  const text = rest.slice(1).join(' ').trim();
  if (!sessionId || !text) throw new Error('usage: dsh-rpc prompt <sessionId> [--wait] [--permission <mode>] [--model <model>] [--timeout <sec>] [--quiet] <text…>');
  checkPermissionAck(permission, allowDangerFullAccess);
  const modelSel = buildModelSelection(model, modelProvider, reasoningEffort);
  // runSession does NOT cancel this session on error — it may pre-exist and
  // belong to prior work, unlike the fresh session created by `run`.
  const result = await runSession({ sessionId, task: text, wait, quiet, permission, timeoutMs, pollMs, model: modelSel, jobId });
  printResult(result, json, wait ? (result.assistantText || `(no assistant text captured — use \`dsh-rpc history ${sessionId}\`)`) : `accepted session ${sessionId}`);
  if (result.outcome === 'BLOCKED') process.exitCode = 3;
  if (result.outcome === 'NEEDS_INPUT') process.exitCode = 4;
}

// CLI-level acknowledgement guard (no server call): the full-access preset is
// only reachable when the user passes --allow-danger-full-access. Whether the
// deployment actually offers the requested preset is validated against its
// `permissions` projection inside applyAndVerifyPermission.
function checkPermissionAck(permission, allowDangerFullAccess) {
  if (permission === 'danger-full-access' && !allowDangerFullAccess) {
    throw new Error('permission danger-full-access requires the explicit --allow-danger-full-access acknowledgement');
  }
}

// dsh-rpc fork <sessionId> [--at-seq <n>] [--model <model>] [--permission <mode>] [--no-wait] [--timeout <sec>] [<text…>]
// Branch an existing session via `session.fork` (the child keeps the parent's
// workspace grouping). With no text, print the child id and stop. With text,
// continue the child (same semantics as `run`, including cancel-on-error since
// the child is freshly created).
async function cmdFork(args) {
  let atSeq;
  let wait = true;
  let quiet = false;
  let json = false;
  let permission = 'read-only';
  let allowDangerFullAccess = false;
  let timeoutMs = 10 * 60 * 1000;
  let pollMs = POLL_MS;
  let model = null;
  let modelProvider = null;
  let reasoningEffort = null;
  let jobId;
  const rest = [];
  let literal = false;
  for (let i = 0; i < args.length; i++) {
    const a = args[i];
    if (literal) { rest.push(a); continue; }
    if (a === '--') { literal = true; }
    else if (a === '--at-seq') { atSeq = Number(nextValue(args, i, '--at-seq')); if (!Number.isInteger(atSeq) || atSeq < 0) throw new Error('--at-seq must be a non-negative integer'); i++; }
    else if (a === '--no-wait') { wait = false; }
    else if (a === '--quiet' || a === '-q') { quiet = true; }
    else if (a === '--json') { json = true; }
    else if (a === '--permission' || a === '-p') { permission = nextValue(args, i, '--permission'); i++; }
    else if (a === '--allow-danger-full-access') { allowDangerFullAccess = true; }
    else if (a === '--timeout') { timeoutMs = parseTimeoutSeconds(nextValue(args, i, '--timeout'), '--timeout'); i++; }
    else if (a === '--poll-ms') { pollMs = Number(nextValue(args, i, '--poll-ms')); if (!Number.isFinite(pollMs) || pollMs <= 0) throw new Error('--poll-ms must be a positive number'); i++; }
    else if (a === '--model') { model = nextValue(args, i, '--model'); i++; }
    else if (a === '--provider') { modelProvider = nextValue(args, i, '--provider'); i++; }
    else if (a === '--reasoning-effort') { reasoningEffort = nextValue(args, i, '--reasoning-effort'); i++; }
    else if (a === '--job-id') { jobId = nextValue(args, i, '--job-id'); i++; }
    else if (a.startsWith('-')) { throw new Error(`unknown option: ${a}`); }
    else { rest.push(a); }
  }
  const sessionId = rest[0];
  const text = rest.slice(1).join(' ').trim();
  if (!sessionId) throw new Error('usage: dsh-rpc fork <sessionId> [--at-seq <n>] [--permission <mode>] [--model <model>] [--no-wait] [--timeout <sec>] [<text…>]');
  checkPermissionAck(permission, allowDangerFullAccess);
  const modelSel = buildModelSelection(model, modelProvider, reasoningEffort);

  const payload = { sessionId };
  if (atSeq !== undefined) payload.atSeq = atSeq;
  const child = await rpc('session.fork', payload);
  const childId = child.sessionId;
  if (!quiet) console.error(`forked ${sessionId} -> ${childId}`);

  if (!text) { printResult({ sessionId: childId, parentSessionId: sessionId }, json, childId); return; }

  try {
    const result = await runSession({ sessionId: childId, task: text, wait, quiet, permission, timeoutMs, pollMs, model: modelSel, jobId });
    printResult({ ...result, parentSessionId: sessionId }, json, wait ? (result.assistantText || `(no assistant text captured — use \`dsh-rpc history ${childId}\`)`) : childId);
    if (result.outcome === 'BLOCKED') process.exitCode = 3;
    if (result.outcome === 'NEEDS_INPUT') process.exitCode = 4;
  } catch (e) {
    // the child is a session we just created — cancel it so a failed run doesn't leave it running
    await cancelSession(childId).catch(() => {});
    throw e;
  }
}

// dsh-rpc search <query> — search the deployment's session history.
async function cmdSearch(args) {
  const query = args.join(' ').trim();
  if (!query) throw new Error('usage: dsh-rpc search <query>');
  const res = await rpc('session.search', { query });
  const items = res.items || [];
  if (!items.length) { console.log('(no matches)'); return; }
  for (const it of items) console.log(`${it.sessionId}\t${it.snippet}`);
  if (res.hasMore) console.error('(more results available)');
}

async function sessionSummary(sessionId) {
  const list = await rpc('session.list', {});
  return (list.items || []).find((item) => item.sessionId === sessionId);
}

async function cmdStatus(args) {
  const sessionId = args[0];
  if (!sessionId) throw new Error('usage: dsh-rpc status <sessionId> [--job-id <id>]');
  let jobId;
  for (let index = 1; index < args.length; index++) {
    if (args[index] === '--job-id') { jobId = nextValue(args, index, '--job-id'); index++; }
    else throw new Error(`unknown status option: ${args[index]}`);
  }
  const [summary, history] = await Promise.all([sessionSummary(sessionId), getHistory(sessionId)]);
  if (!summary) throw new Error(`unknown session: ${sessionId}`);
  const turnEnd = latestTurnEnd(history);
  const assistantText = finalAssistantText(history);
  console.log(JSON.stringify({
    sessionId,
    running: summary.running,
    permission: currentPermission(history),
    pendingApproval: pendingApproval(history) || null,
    turnEndReason: turnEnd && turnEnd.data && turnEnd.data.reason ? turnEnd.data.reason.kind : null,
    outcome: markerOutcome(assistantText, jobId) || null,
    assistantText,
  }, null, 2));
}

async function cmdCancel(args) {
  const sessionId = args[0];
  if (!sessionId || args.length !== 1) throw new Error('usage: dsh-rpc cancel <sessionId>');
  await cancelSession(sessionId);
  console.log(`cancelled ${sessionId}`);
}

async function cmdHistory(args) {
  let json = false;
  const rest = [];
  for (const arg of args) {
    if (arg === '--json') json = true;
    else if (arg.startsWith('-')) throw new Error(`unknown history option: ${arg}`);
    else rest.push(arg);
  }
  const sessionId = rest[0];
  if (!sessionId || rest.length !== 1) throw new Error('usage: dsh-rpc history <sessionId> [--json]');
  const history = await getHistory(sessionId);
  if (json) { console.log(JSON.stringify(history, null, 2)); return; }
  for (const entry of history.events || []) {
    const ev = entry.event || entry;
    if (ev.type === 'user/message' && ev.data && ev.data.message) {
      console.log(`\n=== user ===\n${textOf(ev.data.message)}`);
    } else if (ev.type === 'assistant/message' && ev.data && ev.data.message) {
      const text = textOf(ev.data.message);
      if (text.trim() !== '') console.log(`\n=== assistant ===\n${text}`);
    } else if (ev.type === 'tool/result' && ev.data && ev.data.message) {
      console.log(`\n=== tool-result ===\n${textOf(ev.data.message).slice(0, 400)}`);
    }
  }
}

async function cmdCall(args) {
  let allowUnsafeCall = false;
  const rest = [];
  for (const arg of args) {
    if (arg === '--allow-unsafe-call') allowUnsafeCall = true;
    else rest.push(arg);
  }
  const method = rest[0];
  const payloadJson = rest.slice(1).join(' ');
  if (!method) throw new Error('usage: dsh-rpc call [--allow-unsafe-call] <method> [json-payload]');
  const readOnlyMethods = new Set(['workspace.list', 'session.list', 'session.history', 'session.search', 'session.models']);
  if (!readOnlyMethods.has(method) && !allowUnsafeCall) {
    throw new Error(`raw RPC method ${JSON.stringify(method)} may mutate state; pass --allow-unsafe-call to acknowledge`);
  }
  let payload = {};
  if (payloadJson) {
    try { payload = JSON.parse(payloadJson); }
    catch (e) { throw new Error('payload must be valid JSON: ' + e.message); }
  }
  const value = await rpc(method, payload);
  console.log(JSON.stringify(value, null, 2));
}

const VERSION = `dsh-rpc ${BUILD_ID}\nsource: ${SOURCE_URL}`;

const HELP = `dsh-rpc — guarded DeepSeek Harness RPC automation with grouped sessions.

Usage:
  dsh-rpc workspaces [--table]             list workspaces (JSON by default)
  dsh-rpc sessions [--table]               list sessions (JSON by default)
  dsh-rpc run <task…> [opts]               create a grouped session, send task, wait, print result
       --workspace,-w <path>               exact registered workspace (default: cwd)
       --require-title <title>              also require the registered workspace title
       --create-workspace                   explicitly allow creating a missing workspace
       --permission,-p <mode>              set+verify permission (default: read-only)
       --allow-danger-full-access          required acknowledgement for danger-full-access
       --model <model>                     select the model: a bare id, or <provider>/<model>
       --provider <name>                   disambiguate --model across providers (optional)
       --reasoning-effort <id>             reasoning effort for --model (optional)
       --task-file <path>                  read multiline task text from a file
       --job-id <id>                       require a matching DEEPSEEK_* terminal marker
       --no-wait                           return the session id immediately
       --timeout <sec>                     max wait, then cancel (default 600)
       --poll-ms <milliseconds>            completion polling interval
       --json                              emit structured result evidence
       --quiet,-q                          suppress progress
  dsh-rpc prompt <sessionId> <text…>       send a prompt to an existing session
       --wait [--permission <mode>] [--model <model>] [--job-id <id>] [--json]
  dsh-rpc fork <sessionId> [<text…>]       branch an existing session (child keeps workspace grouping)
       [--at-seq <n>] [--permission <mode>] [--model <model>] [--job-id <id>] [--json]
  dsh-rpc search <query>                   search the deployment's session history
  dsh-rpc status <sessionId> [--job-id]    print guarded status evidence as JSON
  dsh-rpc cancel <sessionId>               explicitly cancel a session
  dsh-rpc history <sessionId> [--json]     print a session's messages
  dsh-rpc call <method> [json]             read-only raw RPC methods
       --allow-unsafe-call                 acknowledge a potentially mutating raw RPC

Env: DSH_URL, DSH_POLL_MS, DSH_RPC_TIMEOUT_MS

Safety defaults: read-only permission, exact pre-registered workspace, strict RPC
envelope and task-admission checks, permission-drift detection, a new completed
turn/end event, optional terminal marker evidence, and cancellation on approval,
timeout, or Ctrl-C.`;

async function main() {
  const [cmd, ...rest] = process.argv.slice(2);
  switch (cmd) {
    case 'workspaces': return cmdWorkspaces(rest);
    case 'sessions': return cmdSessions(rest);
    case 'run': return cmdRun(rest);
    case 'prompt': return cmdPrompt(rest);
    case 'fork': return cmdFork(rest);
    case 'search': return cmdSearch(rest);
    case 'status': return cmdStatus(rest);
    case 'cancel': return cmdCancel(rest);
    case 'history': return cmdHistory(rest);
    case 'call': return cmdCall(rest);
    case 'version': case '--version': case '-V': console.log(VERSION); return;
    case 'help': case '--help': case '-h': case undefined:
      console.log(HELP); return;
    default:
      console.error(`unknown command: ${cmd}\n`);
      console.log(HELP);
      process.exitCode = 2;
  }
}

main().catch((err) => {
  console.error(`dsh-rpc error: ${err.message}`);
  process.exit(1);
});
